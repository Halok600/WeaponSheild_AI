# Root-level model/ (weights dir) is ignored except the final deployed weights —
# Render needs best.pt in the repo since it has no separate model-storage step.
# Anchored with a leading slash so this does NOT match backend/model/ (the
# actual FastAPI detector Python package, which must stay tracked).
/model/*
!/model/best.pt

