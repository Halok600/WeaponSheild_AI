# ── Resend Credentials (email alerts) ────────────────────────────────────────
# Get a free API key at https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "onboarding@resend.dev" works without verifying a domain (good for dev/testing).
# Once you verify your own domain in Resend, switch this to your own address.
RESEND_FROM_EMAIL=WeaponShield AI <onboarding@resend.dev>

# ── YOLO Model ───────────────────────────────────────────────────────────────
# Path to weights file. Defaults to yolov8n.pt (auto-downloaded on first run).
# After fine-tuning use: ../model/best.pt
MODEL_PATH=yolov8n.pt

# ── Detection Config ─────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.45
# Comma-separated class IDs to treat as weapons.
# In base COCO model there are no dedicated weapon classes,
# so after fine-tuning set this to your class indices, e.g.: 0,1,2
WEAPON_CLASS_IDS=

# ── Processing ───────────────────────────────────────────────────────────────
# Resize long edge to this before inference (smaller = faster)
INFERENCE_WIDTH=640
# Number of frames to skip between inferences in video mode (0 = no skip)
FRAME_SKIP=2

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed in production. Leave empty for local dev.
CORS_ORIGINS=

# ── Paths ────────────────────────────────────────────────────────────────────
OUTPUTS_DIR=outputs
