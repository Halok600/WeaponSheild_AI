# ── Twilio Credentials ───────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number
TWILIO_TO_NUMBER=+1XXXXXXXXXX     # Recipient phone number

# ── YOLO Model ───────────────────────────────────────────────────────────────
# Path to weights file. Defaults to yolov8n.pt (auto-downloaded on first run).
# After fine-tuning use: ../model/weapon_detector.pt
MODEL_PATH=yolov8n.pt

# ── Detection Config ─────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.45
# Comma-separated class IDs to treat as weapons.
# In base COCO model there are no dedicated weapon classes,
# so after fine-tuning set this to your class indices, e.g.: 0,1
WEAPON_CLASS_IDS=

# ── Processing ───────────────────────────────────────────────────────────────
# Resize long edge to this before inference (smaller = faster)
INFERENCE_WIDTH=640
# Number of frames to skip between inferences in video mode (0 = no skip)
FRAME_SKIP=2

# ── Paths ────────────────────────────────────────────────────────────────────
OUTPUTS_DIR=outputs
